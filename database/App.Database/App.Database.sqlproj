<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.2.0" />

  <PropertyGroup>
    <Name>App.Database</Name>
    <DacApplicationName>App.Database</DacApplicationName>
    <DacDescription>Reference Azure SQL Managed Instance database project.</DacDescription>
    <DacVersion Condition="'$(DacVersion)' == ''">1.0.0.0</DacVersion>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql170DatabaseSchemaProvider</DSP>
    <!-- ModelCollation controls model comparison only; verify the target database collation separately. -->
    <ModelCollation>1033, CI</ModelCollation>
    <DefaultSchema>dbo</DefaultSchema>
    <BuildStrictness Condition="'$(BuildStrictness)' == ''">Strict</BuildStrictness>
    <RunSqlCodeAnalysis>true</RunSqlCodeAnalysis>
    <TreatTSqlWarningsAsErrors Condition="'$(BuildStrictness)' == 'Lenient'">false</TreatTSqlWarningsAsErrors>
    <TreatTSqlWarningsAsErrors Condition="'$(BuildStrictness)' == 'Balanced'">true</TreatTSqlWarningsAsErrors>
    <TreatTSqlWarningsAsErrors Condition="'$(BuildStrictness)' == 'Strict'">true</TreatTSqlWarningsAsErrors>
    <SuppressTSqlWarnings Condition="'$(BuildStrictness)' == 'Balanced'">$(ValidatedSuppressTSqlWarnings)</SuppressTSqlWarnings>
    <SuppressTSqlWarnings Condition="'$(BuildStrictness)' != 'Balanced'"></SuppressTSqlWarnings>
  </PropertyGroup>

  <ItemGroup>
    <Build Remove="Scripts\**\*.sql" />
    <PostDeploy Include="Scripts\PostDeployment.sql" />
  </ItemGroup>

  <Target Name="ValidateBuildStrictness" BeforeTargets="Build">
    <Error
      Condition="'$(BuildStrictness)' != 'Lenient' and '$(BuildStrictness)' != 'Balanced' and '$(BuildStrictness)' != 'Strict'"
      Text="BuildStrictness must be Lenient, Balanced, or Strict." />
  </Target>
</Project>
